// =====================================================
// O MOCHILÃO — site no Cloudflare (Workers com ficheiros estáticos)
// O Cloudflare corre o build (cloudflare/build.sh), que copia para dist/
// só os ficheiros do site, e publica essa pasta.
// O servidor de pagamentos é outro Worker: ver servidor-pagamentos/.
// =====================================================
{
  "name": "projeto-mochilao",
  "compatibility_date": "2025-01-01",
  "build": {
    "command": "bash cloudflare/build.sh"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
